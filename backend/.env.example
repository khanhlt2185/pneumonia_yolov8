# Cổng chạy FastAPI server
PORT=8000

# Đường dẫn tới mô hình (tính tương đối từ thư mục gốc dự án)
MODEL_PATH=best_pneumonia_model.pt

# Nguồn CORS cho phép truy cập frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Giới hạn dung lượng tải ảnh lên (Megabytes)
MAX_UPLOAD_MB=10

# Bật/tắt thuật toán tiền xử lý CLAHE khi suy luận (khuyến nghị true)
USE_CLAHE=true
